FROM node:24-slim

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates openssl \
  && rm -rf /var/lib/apt/lists/*

COPY . .

RUN npm ci \
  && npm run db:generate \
  && npm run build --workspace=@flowpilot/shared \
  && npm run build --workspace=@flowpilot/worker \
  && npm prune --omit=dev

CMD ["npm", "run", "start", "--workspace=@flowpilot/worker"]
