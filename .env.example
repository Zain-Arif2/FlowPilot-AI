# Local Compose defaults. For Neon + Upstash, replace DATABASE_URL,
# MIGRATION_URL, and REDIS_URL with the hosted values described below.
# Keep this file secret-free; put real credentials in the ignored .env file.
POSTGRES_DB=flowpilot
POSTGRES_USER=flowpilot_migrator
POSTGRES_PASSWORD=local_migration_password
FLOWPILOT_APP_PASSWORD=local_application_password
DATABASE_URL=postgresql://flowpilot_app:local_application_password@localhost:5432/flowpilot?schema=public
MIGRATION_URL=postgresql://flowpilot_migrator:local_migration_password@localhost:5432/flowpilot?schema=public
REDIS_URL=redis://localhost:6379

# Neon + Upstash examples (replace the values above in your .env file):
# DATABASE_URL=postgresql://flowpilot_app:<PASSWORD>@<NEON_DIRECT_HOST>/<DATABASE>?sslmode=require
# MIGRATION_URL=postgresql://<MIGRATION_ROLE>:<PASSWORD>@<NEON_DIRECT_HOST>/<DATABASE>?sslmode=require
# REDIS_URL=rediss://default:<UPSTASH_TOKEN>@<UPSTASH_ENDPOINT>:6379
# Use the Neon direct host with this Prisma client; keep the runtime app role
# separate from the privileged migration role. Upstash requires its Redis
# protocol URL (rediss://), not the REST URL or REST token.

OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=flowpilot-private
OBJECT_STORAGE_ACCESS_KEY=flowpilot-local
OBJECT_STORAGE_SECRET_KEY=local-object-storage-secret
OPENROUTER_API_KEY=replace-with-local-key
OPENROUTER_MODEL=replace-with-approved-model
OPENROUTER_TIMEOUT_MS=30000
SESSION_COOKIE_NAME=flowpilot_session
SESSION_COOKIE_SECURE=false
APP_ORIGIN=http://localhost:3000
API_PORT=3001
API_BODY_LIMIT=1mb
OBJECT_STORAGE_PRESIGN_TTL_SECONDS=300
API_INTERNAL_URL=http://localhost:3001
