FROM node:24-slim

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates libcap2-bin openssl \
  && setcap 'cap_net_bind_service=+ep' "$(command -v node)" \
  && apt-get purge -y --auto-remove libcap2-bin \
  && rm -rf /var/lib/apt/lists/*

COPY . .

RUN npm ci \
  && npm run db:generate \
  && npm run build --workspace=@flowpilot/shared \
  && npm run build --workspace=@flowpilot/api \
  && npm prune --omit=dev \
  && chown -R node:node /app

ENV NODE_ENV=production
ENV PORT=80

EXPOSE 80

USER node

CMD ["npm", "run", "start", "--workspace=@flowpilot/api"]
