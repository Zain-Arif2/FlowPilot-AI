# Copy to .env and replace every placeholder with credentials from your providers.
# Keep .env out of source control; use a secret manager in deployed environments.

# Neon: use the direct connection endpoint and a runtime role with NOBYPASSRLS.
DATABASE_URL=postgresql://flowpilot_app:replace-me@your-neon-host/flowpilot?sslmode=require
# Use a separate migration role for deploy/dev migration commands.
MIGRATION_URL=postgresql://flowpilot_migrator:replace-me@your-neon-host/flowpilot?sslmode=require

# Upstash Redis protocol URL (BullMQ does not use the REST URL/token).
REDIS_URL=rediss://default:replace-me@your-upstash-host:6379

# Cloudinary configuration - backend-only credentials; never expose api_secret.
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me
CLOUDINARY_SIGNED_URL_TTL_SECONDS=300

# Document upload limit for this deployment. The API accepts at most 4 MB.
# DOCUMENT_MAX_BYTES defaults to 4,000,000 bytes.
DOCUMENT_MAX_BYTES=4_000_000

OPENROUTER_API_KEY=replace-with-provider-key
OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free
OPENROUTER_TIMEOUT_MS=30000
# Development-only exception; set true only for synthetic data, with a :free model.
OPENROUTER_ALLOW_NON_ZDR=false
# May retain provider data; enable only if no free model works with data_collection=deny.
OPENROUTER_ALLOW_DATA_COLLECTION=false
JWT_ACCESS_SECRET=replace-with-at-least-32-character-random-access-secret
JWT_REFRESH_SECRET=replace-with-at-least-32-character-random-refresh-secret
JWT_ISSUER=flowpilot-api
JWT_AUDIENCE=flowpilot-web
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
COOKIE_SECURE=false
APP_ORIGIN=http://localhost:3000
API_PORT=3001
API_BODY_LIMIT=1mb
API_INTERNAL_URL=http://localhost:3001

# Optional integration-test resources. These must be disposable, non-production
# services with test-only credentials; never point them at production data.
# FLOWPILOT_TEST_CONFIRM_NON_PRODUCTION=I_CONFIRM_THESE_ARE_DISPOSABLE_NON_PRODUCTION_SERVICES
# FLOWPILOT_TEST_DATABASE_URL=postgresql://test_app:replace-me@your-test-neon-host/flowpilot_test?sslmode=require
# FLOWPILOT_TEST_MIGRATION_URL=postgresql://test_migrator:replace-me@your-test-neon-host/flowpilot_test?sslmode=require
# FLOWPILOT_TEST_REDIS_URL=rediss://default:replace-me@your-test-upstash-host:6379